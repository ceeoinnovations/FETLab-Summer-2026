<mujoco model="lego_arm_writer">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.005" integrator="RK4"/>

  <default>
    <joint damping="0.5" armature="0.01" frictionloss="0.05"/>
    <geom contype="1" conaffinity="1" condim="3" rgba="0.5 0.5 0.5 1"/>
    <position kp="25" kv="3" ctrllimited="true"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.6 0.6 0.7" rgb2="0.2 0.2 0.3" width="256" height="256"/>
    <texture type="2d" name="grid" builtin="checker"
             rgb1="0.28 0.28 0.28" rgb2="0.22 0.22 0.22" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.15"/>
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.8 0.8 0.8" pos="0.5 0 2" dir="-0.5 0 -1"/>
    <light directional="true" diffuse="0.4 0.4 0.4" pos="-0.5 0 2" dir="0.3 0 -1"/>
    <geom name="ground" type="plane" size="1 1 0.01" material="grid"/>

    <!-- Base pedestal -->
    <geom name="pedestal" type="cylinder" size="0.04 0.05"
          pos="0 0 0.05" rgba="0.35 0.35 0.35 1"/>

    <!-- ── Joint 1: Base yaw (Z-axis) — sweeps LED left/right ─────────────── -->
    <body name="turret" pos="0 0 0.1">
      <joint name="j1" type="hinge" axis="0 0 1" range="-1.2 1.2"/>
      <geom type="cylinder" size="0.03 0.022" rgba="0.25 0.45 0.75 1"/>

      <!-- ── Joint 2: Shoulder elevation (Y-axis) — sweeps up/down ─────────── -->
      <body name="upper_arm" pos="0 0 0.022">
        <joint name="j2" type="hinge" axis="0 1 0" range="-0.2 1.2"/>
        <geom type="capsule" fromto="0 0 0 0.14 0 0" size="0.018"
              rgba="0.25 0.72 0.35 1"/>

        <!-- ── Joint 3: Elbow flexion (Y-axis) ────────────────────────────── -->
        <body name="forearm" pos="0.14 0 0">
          <joint name="j3" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
          <geom type="capsule" fromto="0 0 0 0.11 0 0" size="0.013"
                rgba="0.78 0.32 0.22 1"/>

          <!-- LED end-effector -->
          <body name="led_body" pos="0.11 0 0">
            <geom name="led" type="sphere" size="0.014"
                  rgba="1.0 0.92 0.05 1" contype="0" conaffinity="0"/>
            <site name="led" pos="0 0 0" size="0.006" rgba="1 1 0.2 1"/>
          </body>
        </body>
      </body>
    </body>

    <!-- Writing canvas — visual reference only (vertical plane at x=0.23 m) -->
    <geom name="canvas" type="plane" size="0.16 0.10 0.001"
          pos="0.23 0 0.14" euler="0 1.5708 0"
          rgba="0.98 0.98 0.92 0.25" contype="0" conaffinity="0"/>
  </worldbody>

  <!-- Position servos: ctrl[i] = target joint angle in radians -->
  <actuator>
    <position name="act_j1" joint="j1" kp="25" ctrlrange="-1.2  1.2"/>
    <position name="act_j2" joint="j2" kp="25" ctrlrange="-0.2  1.2"/>
    <position name="act_j3" joint="j3" kp="20" ctrlrange="-1.5  1.5"/>
  </actuator>
</mujoco>
