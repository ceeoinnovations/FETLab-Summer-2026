             matching motor.run_*(speed) where speed=100 -> ~115 RPM.
             kv (velocity-tracking gain) and forcerange (torque limit, N*m)
             are BOTH unverified placeholders, no real torque/gain spec
             was available; tune once real data exists (e.g. by comparing
             sim vs. real step-response to a command). -->
        <velocity kv="0.05" ctrlrange="-12.0428 12.0428" ctrllimited="true" forcerange="-0.3 0.3"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <!-- Default friction is (1, 0.005, 0.0001); bumped sliding
             friction way up so the arms actually grip the ground instead
             of sliding freely. MuJoCo combines two contacting geoms'
             friction via elementwise max, so this dominates regardless of
             the terrain plane's own friction setting. Values are an
             unverified "a lot more grip" starting point, not measured
             from real lego-plastic-on-whatever-surface friction; tune
             down if it becomes sticky/jerky, up if it still slides. -->
        <geom group="3" friction="3.0 0.02 0.001"/>
      </default>
