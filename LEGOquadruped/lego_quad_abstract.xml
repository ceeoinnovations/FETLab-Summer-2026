<mujoco model="lego_quad_abstract">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.004" integrator="implicitfast"/>
  <default>
    <default class="crank">
      <joint type="hinge" axis="0 1 0" damping="0.02" armature="0.002"/>
      <position kp="4" forcerange="-2 2"/>
      <default class="link"><geom type="capsule" size="0.006" rgba="0.2 0.45 0.9 1"/></default>
      <default class="foot"><geom type="sphere" size="0.014" friction="1.5 0.02 0.001" rgba="0.1 0.1 0.1 1"/></default>
    </default>
  </default>
  <worldbody>
    <body name="trunk" pos="0 0 0.085" childclass="crank">
      <freejoint name="root"/>
      <geom name="trunk" type="box" size="0.08 0.05 0.025" mass="0.22"/>
      <!-- each leg: one crank hinge; foot at radius 0.07 from the axis (a full turn = one step) -->
      <body name="FL" pos="0.07 0.05 0"><joint name="FLc"/><geom class="link" fromto="0 0 0 0 0 -0.07" mass="0.02"/><geom class="foot" pos="0 0 -0.07" mass="0.01"/></body>
      <body name="FR" pos="0.07 -0.05 0"><joint name="FRc"/><geom class="link" fromto="0 0 0 0 0 -0.07" mass="0.02"/><geom class="foot" pos="0 0 -0.07" mass="0.01"/></body>
      <body name="HL" pos="-0.07 0.05 0"><joint name="HLc"/><geom class="link" fromto="0 0 0 0 0 -0.07" mass="0.02"/><geom class="foot" pos="0 0 -0.07" mass="0.01"/></body>
      <body name="HR" pos="-0.07 -0.05 0"><joint name="HRc"/><geom class="link" fromto="0 0 0 0 0 -0.07" mass="0.02"/><geom class="foot" pos="0 0 -0.07" mass="0.01"/></body>
    </body>
  </worldbody>
  <actuator>
    <position class="crank" name="FLc" joint="FLc"/>
    <position class="crank" name="FRc" joint="FRc"/>
    <position class="crank" name="HLc" joint="HLc"/>
    <position class="crank" name="HRc" joint="HRc"/>
  </actuator>
</mujoco>
