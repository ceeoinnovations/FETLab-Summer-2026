<?xml version="1.0" ?>
<!-- Scene wrapper: includes robot.xml and adds floor + lighting -->
<mujoco model="lego_quadruped_scene">
  <include file="robot.xml"/>

  <statistic center="0 0 0.06" extent="0.4"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <worldbody>
    <light pos="0 0 1.2" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="0 0 0.1" friction="1.2 0.02 0.001" rgba="0.35 0.45 0.55 1"/>
  </worldbody>
</mujoco>